# .gitignore
# Path: /Users/eleheim/projects/piper/.gitignore
# Keeps build outputs, caches and local tooling out of the speech pack builder repository.

# Build outputs live outside the repository (PACKS_HOST_DIR, WORK_HOST_DIR),
# these cover a local run that points them inside it.
packs/
work/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and systems
.vscode/
.idea/
*.swp
*~
.DS_Store

# Local compose overrides
docker-compose.override.yml
