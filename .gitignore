# .gitignore
# Path: /root/piper/.gitignore
# Keeps build outputs, caches and local tooling out of the speech pack builder repository.

# Build outputs: PACKS_HOST_DIR and WORK_HOST_DIR (.env) point inside the
# repository, and ./publish.sh uploads the packs from there.
packs/
work/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and systems
.vscode/
.idea/
*.swp
*~
.DS_Store

# Local compose overrides
docker-compose.override.yml
