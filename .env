# .env
# Path: /root/piper/.env
# Local build paths, publish targets and logging level for the speech pack builder.

# The builder runs on a workstation (a Mac with Docker Desktop, or any Linux
# machine with Docker), never on the web host: the Whisper export alone takes
# several gigabytes of memory and every core for minutes, which a web server
# cannot spare while it serves traffic. Both directories are relative to this
# repository and ignored by git.

# Where the finished packs are written; ./publish.sh uploads this directory.
PACKS_HOST_DIR=./packs

# Download cache, extracted archives and the Whisper export. Keep it between
# builds: the Whisper export takes minutes and several gigabytes of downloads.
WORK_HOST_DIR=./work

# Where ./publish.sh uploads the packs: space-separated ssh targets, each
# <user>@<host>:<directory>. The directory is the PACKS_DIR of that host's web
# deployment (web repo: deployment/production.env.example, staging.env.example),
# which its `packs` service serves read-only at https://<domain>/packs/.
# Example: PUBLISH_TARGETS="root@web-prod:/srv/speech-packs root@web-staging:/srv/speech-packs"
PUBLISH_TARGETS=

LOG_LEVEL=INFO
