# .env
# Path: /root/piper/.env
# Host paths and logging level for the speech pack builder.

# Where the finished packs are written. On the web host this is the directory
# its nginx serves read-only at https://<domain>/packs/ (web repo: PACKS_DIR).
# Building elsewhere (e.g. a Mac), point both paths at directories there and
# copy this one to the web host after the build.
PACKS_HOST_DIR=/srv/speech-packs

# Download cache, extracted archives and the Whisper export. Keep it between
# builds: the Whisper export takes minutes and several gigabytes of downloads.
WORK_HOST_DIR=/srv/speech-packs-work

LOG_LEVEL=INFO
