# .env
# Path: /Users/eleheim/projects/piper/.env
# Host paths and logging level for the speech pack builder, and where ./publish.sh sends the packs.

# Where the finished packs are written, on the Mac that builds them. Copied
# afterwards to /srv/speech-packs on the web host, whose nginx serves it
# read-only at https://oropen.com/packs/ (web repo: PACKS_DIR); see publish.sh.
PACKS_HOST_DIR=/Users/eleheim/projects/speech-packs

# Download cache, extracted archives and the Whisper export. Keep it between
# builds: the Whisper export takes minutes and several gigabytes of downloads.
WORK_HOST_DIR=/Users/eleheim/projects/speech-packs-work

LOG_LEVEL=INFO

# ./publish.sh: the web host over Tailscale (its firewall allows SSH on no
# other interface), the directory its `packs` service serves, and the public
# URL that must serve the new manifest once it is published.
PUBLISH_HOST=root@100.110.223.15
PUBLISH_DIR=/srv/speech-packs
PUBLISH_URL=https://oropen.com/packs/manifest.json
